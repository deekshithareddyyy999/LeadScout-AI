# TEMPLATE ONLY. Copy to .env.local (same folder) and fill in .env.local. Restart `npm run dev` after changes.
# Everything here is bundled into the browser code, so never put secret keys in this file.

# Google map for Google Places results (Seeker → Location Opportunities when the data source is Google Places).
# This is a *browser* key: public by design, protected by restrictions you set in Google Cloud →
#   Application restrictions: Websites → http://localhost:5173/*   ·   API restrictions: Maps JavaScript API only.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional. Google's DEMO_MAP_ID is used when empty (fine for development).
VITE_GOOGLE_MAPS_MAP_ID=

# Optional overrides for the OpenStreetMap side.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_GEOCODER_URL=
VITE_OVERPASS_URL=
