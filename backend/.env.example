# TEMPLATE ONLY — do not put real keys in this file. Copy it to .env (same folder) and fill in .env.
# Every value is optional: the server starts without them and reports what's missing at GET /api/health.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Google Places API (New), used for location search. Google Cloud Console → Maps Platform → Credentials.
# Needs billing enabled on the Cloud project. Restrict the key to "Places API (New)".
GOOGLE_PLACES_API_KEY=

# AI analysis. Set either one (or both). Check them at GET /api/health/ai.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Database: Supabase Data API over HTTPS. Check it at GET /api/health/db.
# URL: https://<project-ref>.supabase.co. Secret key: Project Settings → API Keys → secret (sb_secret_…) or legacy service_role.
# The secret key bypasses Row Level Security, so it stays server-side only.
# Create the tables once by running src/db/migrations/0002_supabase_schema.sql in Supabase → SQL Editor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Signs the sign-in cookie. Any long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Networks with TLS inspection (e.g. a corporate laptop): Node must trust the inspecting root certificate.
# Set NODE_EXTRA_CA_CERTS=<path to root CA .pem> as an OS environment variable — it is read before .env loads.
